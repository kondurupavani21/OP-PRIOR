# ==============================================================
# MedQueue AI - Backend Environment Configuration Template
# ==============================================================

# Application Metadata
PROJECT_NAME=MedQueue AI Backend
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Server Host & Port
HOST=127.0.0.1
PORT=8000
API_V1_STR=/api/v1

# CORS Allowed Origins (Comma-separated for React + Vite frontend)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Primary: MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=medqueue_ai
USE_MONGOMOCK=False
DATABASE_URL=sqlite:///./medqueue.db

# Security & JWT Tokens
SECRET_KEY=medqueue-secret-key-change-in-production-098f6bcd4621d373cade4e832627b4f6
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Medical Document Storage & OCR Configuration
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=uploads/documents
ENABLE_TESSERACT_OCR=True

# AI Clinical Summarization & LLM Configuration
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

